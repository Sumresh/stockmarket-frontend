# StockCheck AI Frontend — Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL — defaults to /api which is proxied via vercel.json (production)
# and vite.config.js (local dev). Only set this if you need to hit a different backend.
# VITE_API_BASE_URL=/api

# Supabase (public/anon key — safe to expose in frontend)
VITE_SUPABASE_URL=https://gsxexhhlqotqidkbrfoq.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
